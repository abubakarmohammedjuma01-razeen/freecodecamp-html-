CTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Survey Form</title>
  </head>

  <body>
     <header>
        <h1 id="title">Level Up Your Feedback</h1>
        <p id="description">Help us refine the next generation of gaming experiences.</p>
    </header>

    <form id="survey-form">

        <div class="form-group">
            <label id="name-label" for="name">Name</label>
            <input type="text" id="name" placeholder="Enter your player name" required>
        </div>

        <div class="form-group">
            <label id="email-label" for="email">Email</label>
            <input type="email" id="email" placeholder="Enter your email" required>
        </div>

        <div class="form-group">
            <label id="number-label" for="number">Weekly Hours Gaming</label>
            <input type="number" id="number" min="0" max="168" placeholder="0-168">
        </div>

        <div class="form-group">
            <label for="dropdown">Primary Platform</label>
            <select id="dropdown">
                <option disabled selected value>Select your gear</option>
                <option value="pc">PC (Master Race)</option>
                <option value="console">Console</option>
                <option value="mobile">Mobile</option>
                <option value="vr">VR</option>
            </select>
        </div>

        <div class="form-group">
            <p>Would you recommend this title?</p>
            <label class="radio-label">
                <input type="radio" name="recommend" value="definitely" checked> Definitely
            </label>
            <label class="radio-label">
                <input type="radio" name="recommend" value="maybe"> Maybe
            </label>
            <label class="radio-label">
                <input type="radio" name="recommend" value="not-sure"> Not Sure
            </label>
        </div>

        <div class="form-group">
            <p>Favorite Genres (Select all that apply)</p>
            <label><input type="checkbox" value="rpg"> RPG</label>
            <label><input type="checkbox" value="fps"> FPS</label>
            <label><input type="checkbox" value="mmo"> MMO</label>
            <label><input type="checkbox" value="indie"> Indie</label>
        </div>

        <div class="form-group">
            <p>Any secret cheat codes or suggestions?</p>
            <textarea id="comments" placeholder="Type your message here..."></textarea>
        </div>

        <button type="submit" id="submit">Submit Data</button>
    </form>
  </body>
</html>
